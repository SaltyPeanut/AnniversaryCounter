<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <CheckBox
            android:id="@+id/cbUseLightTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_outline"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/use_light_theme"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnQuickMenuSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_outline"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/btn_quick_menu_settings"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnAppearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_outline"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/btn_appearance"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnFormatSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_outline"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/btn_format_settings"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnReorderCounters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_outline"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/btn_reorder_counters"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnImportCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_outline"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/btn_import_calendar"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnExportBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_outline"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/btn_export_backup"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnImportBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_outline"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/btn_import_backup"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>
