<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_outline"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/btn_notifications"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnSetContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_outline"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnNotifyContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_outline"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/btn_notify_contact"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnRemoveContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_outline"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/btn_remove_contact"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
