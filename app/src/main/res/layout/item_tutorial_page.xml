<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Telefon-Skizze: TutorialActivity markiert darin den jeweils erklaerten Bereich. -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="340dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/btn_outline">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:text="@string/title"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/mockGear"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/btn_circle"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_settings" />

            <LinearLayout
                android:id="@+id/mockTime"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="76dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle_default"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/appearance_preview_numbers"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/mockArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="44dp"
                android:textColor="#FF4D6D"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mockPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:padding="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/mockSheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="4dp"
                android:background="@drawable/bg_tutorial_highlight"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="8dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTutorialTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTutorialBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
